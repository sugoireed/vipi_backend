# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CSRF_TRUSTED_ORIGINS=
# sqlite by default; local MySQL e.g. mysql://root:@127.0.0.1:3306/vipi, or postgres://vipi:pass@127.0.0.1:5432/vipi
#DATABASE_URL=

# Translation engine (server-side key — the app no longer needs one)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Vipi engine (engine/, run separately): Riba + Mufti/Risto; Gemini above is the fallback. Empty = Gemini only.
VIPI_ENGINE_URL=
VIPI_ENGINE_KEY=
VIPI_ENGINE_TIMEOUT=25
FREE_DAILY_TRANSLATIONS=10
MAX_CLIP_SECONDS=30
# Talk clips for /contribute/ (default: ../sheng_dataset/raw/radio)
TRANSCRIPT_CLIPS_ROOT=
USD_TO_KES=129

# Safaricom Daraja (M-Pesa Express / STK push). Sandbox shortcode 174379.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain/api/v1/payments/mpesa/callback
MPESA_CALLBACK_SECRET=pick-a-random-string

# eSIM data bundles: "sandbox" (fake eSIMs for testing) or "airalo" (Airalo Partner API)
ESIM_PROVIDER=sandbox
AIRALO_BASE_URL=https://sandbox-partners-api.airalo.com
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=

# Market: ke (vipikenya.com) | ug | tz. Brand is VipiAfrica in every market; this sets the domain, emails and links.
VIPI_MARKET=ke
# Public website the dashboard links back to (defaults to https://<market domain>)
# SITE_URL=https://vipikenya.com
